#pragma once

// NTFY_TOPIC — длинное случайное имя топика ntfy.sh, по сути это пароль (тот же, что в .ntfy_topic для pc_agent.py)
// TARGET_MAC — MAC сетевой карты ПК (ip link), пример: C8:7F:54:3A:1B:2E -> { 0xC8, 0x7F, 0x54, 0x3A, 0x1B, 0x2E }
// OTA_PASSWORD — пароль для прошивки по сети (ArduinoOTA), порт 3232
#define WIFI_SSID      "MyHomeNetwork"
#define WIFI_PASSWORD  "supersecret123"
#define NTFY_TOPIC     "wol-<random-uuid>"
#define TARGET_MAC     { 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF }
#define OTA_PASSWORD   "change-me"
